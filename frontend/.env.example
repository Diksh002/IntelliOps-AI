# ==============================================================================
# IntelliOps AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local before starting the Next.js frontend:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. BACKEND API TARGET URL
# ------------------------------------------------------------------------------
# Required for startup: No (defaults to http://localhost:8000 in lib/api.ts)
# Required for frontend-backend communication: Yes
# Description: The URL where the FastAPI backend server is accessible.
NEXT_PUBLIC_API_URL=http://localhost:8000
