# ==============================================================================
# IntelliOps AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS (Optional / Defaults provided)
# ------------------------------------------------------------------------------
# Required for startup: No (defaults will be used if omitted)
# Description: Host binding, port, debug mode, and log level.
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Database location (defaults to local SQLite file datascout.db)
DATABASE_URL=sqlite:///./datascout.db

# ------------------------------------------------------------------------------
# 2. AI & LLM PROVIDER (Required ONLY for Natural-Language AI / Supervisor)
# ------------------------------------------------------------------------------
# Required for startup: No (server runs in offline mode if omitted)
# Required for AI features: Yes (/chat, SQL Agent, Visualizer)
# Description: OpenAI API key. Must start with 'sk-' or 'sk-proj-'.
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE / RAG (Required ONLY for Document Retrieval)
# ------------------------------------------------------------------------------
# Required for startup: No
# Required for RAG features: Yes (when using cloud Pinecone vector store)
# Description: Pinecone vector database configuration.
PINECONE_API_KEY=pcsk_your-key-here
PINECONE_INDEX_NAME=datascout
PINECONE_HOST=https://datascout-xxxxx.svc.aped-4627-b74a.pinecone.io

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & TRACING (Optional)
# ------------------------------------------------------------------------------
# Required for startup: No
# Description: LangSmith / LangChain tracing for multi-agent debugging.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your-key-here
LANGCHAIN_PROJECT=intelliops-ai
